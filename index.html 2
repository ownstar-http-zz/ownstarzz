<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#f5f0e8"><title>Margem — suas ideias, do seu jeito</title>
<style>
:root{--paper:#fffdf9;--ink:#272522;--muted:#807a72;--line:#eae4da;--accent:#6557a5;--soft:#f0ecf8;--bg:#f5f0e8;--side:280px}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;height:100vh;overflow:hidden}.app{display:grid;grid-template-columns:var(--side) 1fr;height:100vh}.sidebar{background:#fbf9f5;border-right:1px solid var(--line);padding:24px 17px;display:flex;flex-direction:column;gap:18px;overflow:auto}.brand{display:flex;align-items:center;gap:10px;padding:0 8px}.brand-mark{width:34px;height:34px;border-radius:12px;background:var(--accent);color:white;display:grid;place-items:center;font-size:20px}.brand-name{font-weight:750;letter-spacing:-.5px;font-size:19px}.brand-sub{color:var(--muted);font-size:11px;margin-top:1px}.new-note,.primary{border:0;background:var(--accent);color:#fff;border-radius:12px;padding:12px 14px;font:inherit;font-weight:650;cursor:pointer;box-shadow:0 4px 12px #6557a526}.new-note:hover,.primary:hover{filter:brightness(1.07)}.nav{display:grid;gap:4px}.navbtn,.noteitem{width:100%;border:0;background:transparent;color:#59544f;text-align:left;padding:10px 11px;border-radius:10px;font:inherit;cursor:pointer;display:flex;gap:10px;align-items:center}.navbtn:hover,.noteitem:hover{background:#f0ece5}.navbtn.active,.noteitem.active{background:var(--soft);color:var(--accent);font-weight:650}.navicon{width:20px;text-align:center}.section-label{font-size:10px;text-transform:uppercase;letter-spacing:1.2px;color:#9a9389;padding:5px 10px 1px}.notes-list{display:grid;gap:2px}.noteitem{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:13px}.noteitem small{display:block;color:#a29b91;font-size:11px;margin-top:3px}.sidebar-bottom{margin-top:auto;border-top:1px solid var(--line);padding-top:14px;display:grid;gap:6px}.side-action{background:none;border:0;text-align:left;color:#716b63;padding:8px 10px;border-radius:9px;font:inherit;font-size:13px;cursor:pointer}.side-action:hover{background:#f0ece5}.main{min-width:0;display:flex;flex-direction:column;position:relative}.topbar{height:65px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px;background:#ffffff80}.crumb{font-size:13px;color:var(--muted)}.top-actions{display:flex;gap:8px;align-items:center}.iconbtn{border:1px solid var(--line);background:var(--paper);color:#5e5953;border-radius:10px;height:36px;padding:0 11px;cursor:pointer;font:inherit;font-size:13px}.iconbtn:hover{border-color:#bdb4d1;color:var(--accent)}.workspace{overflow:auto;flex:1;padding:44px 22px}.page{max-width:800px;margin:0 auto;min-height:100%;background:var(--paper);border:1px solid #ebe5dc;border-radius:18px;box-shadow:0 10px 34px #6b57430b;padding:46px 60px;position:relative}.title-input{width:100%;border:0;outline:0;background:transparent;color:var(--ink);font:700 34px/1.2 inherit;font-size:34px;font-weight:750;letter-spacing:-1.2px;padding:0;margin:0 0 8px}.meta{font-size:12px;color:#aaa297;margin-bottom:24px}.toolbar{position:sticky;top:0;z-index:3;display:flex;gap:5px;flex-wrap:wrap;padding:9px 12px;background:#fffdf9ed;backdrop-filter:blur(12px);border:1px solid var(--line);border-radius:13px;width:max-content;max-width:100%;margin:0 auto 26px;box-shadow:0 3px 14px #32200b0c}.tool{border:0;background:transparent;border-radius:8px;padding:7px 9px;cursor:pointer;color:#514c46;font:inherit;font-size:13px}.tool:hover{background:var(--soft);color:var(--accent)}.tool select{border:0;background:transparent;color:inherit;font:inherit;outline:none}.color-picker{width:28px;height:28px;border:0;background:transparent;padding:3px;cursor:pointer}.editor{min-height:420px;outline:0;font-size:16px;line-height:1.8;color:var(--ink);overflow-wrap:anywhere}.editor:empty:before{content:attr(data-placeholder);color:#bbb4aa}.editor h1,.editor h2,.editor h3{line-height:1.3;letter-spacing:-.4px;margin:24px 0 10px}.editor h1{font-size:29px}.editor h2{font-size:23px}.editor h3{font-size:19px}.editor p{margin:0 0 14px}.editor blockquote{border-left:3px solid var(--accent);margin:20px 0;padding:5px 16px;color:#746b85;background:#f7f4fa;border-radius:0 8px 8px 0}.editor hr{border:0;border-top:1px solid #dcd5ca;margin:25px 0}.editor img{max-width:100%;border-radius:12px;margin:10px 0}.editor ul,.editor ol{padding-left:24px}.status{font-size:11px;color:#a19a91}.empty{height:100%;display:grid;place-items:center;text-align:center;color:var(--muted)}.empty-card{max-width:360px}.empty-icon{font-size:38px;margin-bottom:12px}.empty h2{color:var(--ink);margin:0 0 8px}.empty p{line-height:1.6}.panel{max-width:800px;margin:0 auto;background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:34px 40px;box-shadow:0 10px 34px #6b57430b}.panel h1{font-size:30px;letter-spacing:-.8px;margin:0 0 8px}.panel-intro{color:var(--muted);line-height:1.6;margin:0 0 24px}.searchrow{display:flex;gap:9px}.searchrow input,.textinput{flex:1;min-width:0;border:1px solid var(--line);border-radius:11px;padding:12px 14px;font:inherit;outline:0;background:#fff}.searchrow input:focus,.textinput:focus{border-color:var(--accent)}.result{border-top:1px solid var(--line);padding:17px 0}.result a{color:var(--accent);font-weight:650;text-decoration:none}.result p{margin:6px 0 0;color:#635e58;line-height:1.55}.result small{color:#a19a91}.ai-box{margin-top:22px;background:#f5f2fa;border:1px solid #e5def0;border-radius:14px;padding:17px}.ai-title{font-weight:700;margin-bottom:5px}.ai-state{color:var(--muted);font-size:13px;line-height:1.5}.ai-answer{white-space:pre-wrap;line-height:1.7;margin-top:12px}.community-badge{display:inline-block;background:#f5efdf;color:#795c1c;border-radius:999px;padding:5px 10px;font-size:11px;font-weight:650}.postbox{border:1px solid var(--line);border-radius:13px;padding:14px;margin:18px 0}.postbox textarea{width:100%;min-height:74px;border:0;resize:vertical;font:inherit;outline:0}.post{border-top:1px solid var(--line);padding:16px 2px;line-height:1.6}.post small{color:#9a9389}.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.setting{border:1px solid var(--line);border-radius:12px;padding:14px}.setting label{display:block;font-size:13px;font-weight:650;margin-bottom:9px}.setting input[type=color]{width:100%;height:37px;border:0;background:none;cursor:pointer}.setting input[type=url]{width:100%;border:1px solid var(--line);border-radius:8px;padding:9px;font:inherit}.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:#302b37;color:white;border-radius:10px;padding:10px 15px;font-size:13px;z-index:10;opacity:0;transition:opacity .2s;pointer-events:none}.toast.show{opacity:1}.mobile-menu{display:none}.fileinput{display:none}
@media(max-width:760px){.app{grid-template-columns:1fr}.sidebar{position:fixed;inset:0 auto 0 0;width:280px;z-index:5;transform:translateX(-105%);transition:transform .2s;box-shadow:12px 0 30px #0002}.sidebar.open{transform:translateX(0)}.mobile-menu{display:inline-flex}.topbar{padding:0 14px;height:58px}.workspace{padding:18px 10px}.page{padding:28px 22px;min-height:calc(100vh - 100px)}.title-input{font-size:29px}.toolbar{margin-bottom:20px}.panel{padding:26px 20px}.settings-grid{grid-template-columns:1fr}.top-actions .iconbtn{padding:0 9px}}

/* No celular, a página inteira rola naturalmente, sem prender o conteúdo. */
@media (max-width:760px){
  html,body{height:auto;min-height:100%;overflow-x:hidden;overflow-y:auto}
  .app{display:block;height:auto;min-height:100vh}
  .main{min-height:100vh}
  .workspace{overflow:visible;flex:1}
  .toolbar{position:relative;top:auto}
}
</style>
</head>
<body><div class="app">
<aside class="sidebar" id="sidebar"><div class="brand"><div class="brand-mark">m</div><div><div class="brand-name">margem</div><div class="brand-sub">suas ideias, do seu jeito</div></div></div>
<button class="new-note" id="newNote">＋ &nbsp; Nova nota</button>
<nav class="nav"><button class="navbtn active" data-view="notes"><span class="navicon">▤</span> Minhas notas</button><button class="navbtn" data-view="research"><span class="navicon">⌕</span> Pesquisa + IA</button><button class="navbtn" data-view="community"><span class="navicon">♡</span> Comunidade</button><button class="navbtn" data-view="settings"><span class="navicon">⚙</span> Personalizar app</button></nav>
<div><div class="section-label">Notas recentes</div><div class="notes-list" id="notesList"></div></div><div class="sidebar-bottom"><button class="side-action" id="exportBtn">⇩ &nbsp; Exportar minhas notas</button><button class="side-action" id="importBtn">⇧ &nbsp; Importar backup</button><input class="fileinput" id="importFile" type="file" accept="application/json"><div class="status" id="saveStatus">Salvo neste aparelho</div></div></aside>
<main class="main"><header class="topbar"><div style="display:flex;align-items:center;gap:10px"><button class="iconbtn mobile-menu" id="menuBtn">☰</button><span class="crumb" id="crumb">Minhas notas</span></div><div class="top-actions"><button class="iconbtn" id="bgBtn" title="Mudar fundo">◐ Fundo</button><button class="iconbtn" id="focusBtn" title="Modo foco">⤢ Foco</button></div></header><section class="workspace" id="workspace"></section></main></div><div class="toast" id="toast"></div>
<script type="module">
import { pipeline, env } from 'https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.5.2';
env.allowLocalModels = false;
const $=s=>document.querySelector(s);const storeKey='margem-notes-v1';let state=loadState(),view='notes',current=state.notes[0]?.id||null,aiPipeline=null,aiLoading=false,debounce;
function loadState(){try{let s=JSON.parse(localStorage.getItem(storeKey));if(s?.notes)return s}catch{}return{notes:[{id:crypto.randomUUID(),title:'Minha primeira nota',content:'<p>Esse espaço é seu. Escreva sem medo de ficar sem caracteres, personalize do seu jeito e coloque suas ideias no papel.</p><h2>Algumas coisas para testar</h2><p>Use os botões acima para criar <strong>títulos</strong>, listas, divisórias, cores e imagens. ✨</p><hr><p>Suas notas ficam salvas neste aparelho.</p>',updated:Date.now()}],settings:{accent:'#6557a5',bg:'#f5f0e8',font:'#272522',image:''},posts:[]}}
function save(){localStorage.setItem(storeKey,JSON.stringify(state));$('#saveStatus').textContent='Salvo neste aparelho · '+new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});renderList()}
function toast(t){let el=$('#toast');el.textContent=t;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),2300)}function esc(s=''){return s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function applySettings(){document.documentElement.style.setProperty('--accent',state.settings.accent||'#6557a5');document.documentElement.style.setProperty('--bg',state.settings.bg||'#f5f0e8');document.documentElement.style.setProperty('--ink',state.settings.font||'#272522');document.body.style.backgroundImage=state.settings.image?`linear-gradient(#f5f0e8cc,#f5f0e8cc),url("${state.settings.image}")`:'';document.body.style.backgroundSize='cover';document.body.style.backgroundAttachment='fixed'}
function renderList(){let root=$('#notesList');root.innerHTML=state.notes.map(n=>`<button class="noteitem ${n.id===current&&view==='notes'?'active':''}" data-id="${n.id}">${esc(n.title||'Sem título')}<small>${new Date(n.updated).toLocaleDateString('pt-BR')}</small></button>`).join('');root.querySelectorAll('.noteitem').forEach(b=>b.onclick=()=>{current=b.dataset.id;view='notes';render();$('#sidebar').classList.remove('open')})}
function render(){applySettings();renderList();$('#crumb').textContent=({notes:'Minhas notas',research:'Pesquisa + IA',community:'Comunidade',settings:'Personalizar app'})[view];$('#bgBtn').style.display=view==='notes'?'':'none';let w=$('#workspace');if(view==='notes')renderNote(w);else if(view==='research')renderResearch(w);else if(view==='community')renderCommunity(w);else renderSettings(w);document.querySelectorAll('.navbtn').forEach(b=>b.classList.toggle('active',b.dataset.view===view))}
function renderNote(w){let n=state.notes.find(x=>x.id===current);if(!n){w.innerHTML='<div class="empty"><div class="empty-card"><div class="empty-icon">✎</div><h2>Comece por uma ideia</h2><p>Crie sua primeira nota e deixe ela com a sua cara.</p><button class="primary" id="emptyNew">Criar nota</button></div></div>';$('#emptyNew').onclick=newNote;return}w.innerHTML=`<article class="page"><input class="title-input" id="noteTitle" maxlength="300" placeholder="Título da nota" value="${esc(n.title)}"><div class="meta">Atualizada ${new Date(n.updated).toLocaleString('pt-BR',{dateStyle:'medium',timeStyle:'short'})}</div><div class="toolbar"><button class="tool" data-cmd="bold"><b>B</b></button><button class="tool" data-cmd="italic"><i>I</i></button><button class="tool" data-cmd="underline"><u>U</u></button><button class="tool" data-format="h1">H1</button><button class="tool" data-format="h2">H2</button><button class="tool" data-format="p">¶</button><button class="tool" data-cmd="insertUnorderedList">☷</button><button class="tool" data-cmd="insertOrderedList">1.</button><button class="tool" id="dividerBtn">—</button><button class="tool" id="quoteBtn">❞</button><label class="tool" title="Cor do texto">A<input type="color" class="color-picker" id="textColor" value="${state.settings.font||'#272522'}"></label><button class="tool" id="imageBtn">▧ Imagem/GIF</button><input class="fileinput" id="imageFile" type="file" accept="image/*,image/gif"><button class="tool" id="linkImageBtn">↗ Link de imagem</button><button class="tool" id="deleteNote" style="margin-left:auto;color:#ad5b58">Excluir</button></div><div class="editor" id="editor" contenteditable="true" spellcheck="true" data-placeholder="Comece a escrever…">${n.content||''}</div></article>`;
$('#noteTitle').oninput=e=>{n.title=e.target.value;n.updated=Date.now();save()};$('#editor').oninput=()=>{clearTimeout(debounce);$('#saveStatus').textContent='Salvando…';debounce=setTimeout(()=>{n.content=$('#editor').innerHTML;n.updated=Date.now();save()},250)};
document.querySelectorAll('[data-cmd]').forEach(b=>b.onclick=()=>{document.execCommand(b.dataset.cmd,false,null);$('#editor').focus()});document.querySelectorAll('[data-format]').forEach(b=>b.onclick=()=>{document.execCommand('formatBlock',false,b.dataset.format);$('#editor').focus()});$('#dividerBtn').onclick=()=>{document.execCommand('insertHorizontalRule');$('#editor').focus()};$('#quoteBtn').onclick=()=>{document.execCommand('formatBlock',false,'blockquote');$('#editor').focus()};$('#textColor').oninput=e=>{document.execCommand('foreColor',false,e.target.value);$('#editor').focus()};$('#imageBtn').onclick=()=>$('#imageFile').click();$('#imageFile').onchange=e=>{let f=e.target.files[0];if(!f)return;if(f.size>4*1024*1024){toast('Imagem acima de 4 MB: use “Link de imagem”.');return}let r=new FileReader();r.onload=()=>{document.execCommand('insertImage',false,r.result);$('#editor').focus();$('#editor').dispatchEvent(new Event('input'))};r.readAsDataURL(f)};$('#linkImageBtn').onclick=()=>{let u=prompt('Cole o link direto da imagem ou GIF:');if(u&&/^https?:\/\//i.test(u)){document.execCommand('insertImage',false,u);$('#editor').focus();$('#editor').dispatchEvent(new Event('input'))}else if(u)toast('Precisa começar com http:// ou https://')};$('#deleteNote').onclick=()=>{if(confirm('Excluir esta nota?')){state.notes=state.notes.filter(x=>x.id!==n.id);current=state.notes[0]?.id||null;save();render()}}}
function newNote(){let n={id:crypto.randomUUID(),title:'Nova nota',content:'',updated:Date.now()};state.notes.unshift(n);current=n.id;view='notes';save();render();$('#noteTitle')?.focus()}
function renderResearch(w){w.innerHTML=`<div class="panel"><h1>Pesquisa + IA <span style="font-size:22px">✦</span></h1><p class="panel-intro">Pesquise na Wikipédia e peça à IA para resumir. O modelo roda no seu navegador: sem conta, sem chave e sem cobrança. Na primeira vez, ele baixa arquivos grandes e pode levar alguns minutos.</p><div class="searchrow"><input id="query" placeholder="O que você quer descobrir?" maxlength="300"><button class="primary" id="searchBtn">Pesquisar</button></div><div class="ai-box"><div class="ai-title">✦ Resumo com IA gratuita</div><div class="ai-state" id="aiState">Faça uma pesquisa. A IA usará os resultados como contexto. Requer navegador compatível com WebGPU para funcionar mais rápido.</div><div class="ai-answer" id="aiAnswer"></div></div><div id="results"></div></div>`;$('#searchBtn').onclick=doResearch;$('#query').onkeydown=e=>{if(e.key==='Enter')doResearch()}}
async function doResearch(){let q=$('#query').value.trim();if(!q)return;$('#results').innerHTML='<p class="ai-state">Buscando fontes…</p>';$('#aiAnswer').textContent='';$('#aiState').textContent='Preparando a pesquisa…';try{let r=await fetch('https://pt.wikipedia.org/w/api.php?action=query&generator=search&gsrsearch='+encodeURIComponent(q)+'&gsrlimit=4&prop=extracts&exintro=1&explaintext=1&exchars=900&format=json&origin=*');if(!r.ok)throw Error('Falha ao consultar Wikipédia');let d=await r.json(),pages=Object.values(d.query?.pages||{});if(!pages.length){$('#results').innerHTML='<p>Nenhum resultado encontrado. Tente outras palavras.</p>';$('#aiState').textContent='Sem resultados para resumir.';return}$('#results').innerHTML=pages.map(p=>`<div class="result"><a href="https://pt.wikipedia.org/?curid=${p.pageid}" target="_blank" rel="noopener">${esc(p.title)} ↗</a><p>${esc(p.extract||'Abra o artigo para ler mais.')}</p><small>Wikipédia · abra o link para conferir a fonte</small></div>`).join('');let context=pages.map(p=>p.title+': '+(p.extract||'')).join('\n\n');$('#aiState').textContent='Carregando IA gratuita no seu navegador…';await summarize(q,context)}catch(e){$('#results').innerHTML='<p>Não consegui buscar agora. Confira sua conexão e tente de novo.</p>';$('#aiState').textContent='A pesquisa precisa de internet para consultar as fontes.'}}
async function summarize(q,context){try{if(!aiPipeline){if(aiLoading)return;aiLoading=true;aiPipeline=await pipeline('text-generation','onnx-community/Qwen2.5-0.5B-Instruct',{dtype:'q4f16',device:'webgpu',progress_callback:p=>{if(p.status==='progress')$('#aiState').textContent=`Baixando o modelo de IA… ${Math.round(p.progress||0)}%`}});aiLoading=false}$('#aiState').textContent='A IA está preparando um resumo…';let prompt=`Responda em português brasileiro, com linguagem simples. Resuma os dados da pesquisa em até 5 tópicos e diga se algo importante não está nos trechos. Pergunta: ${q}\n\nFontes:\n${context}`;let out=await aiPipeline(prompt,{max_new_tokens:220,do_sample:false});$('#aiAnswer').textContent=out[0]?.generated_text?.slice(prompt.length).trim()||out[0]?.generated_text||'Não consegui gerar o resumo.';$('#aiState').textContent='Resumo gerado no seu navegador. Confira as fontes nos links acima.'}catch(e){aiLoading=false;$('#aiState').textContent='A IA local não iniciou neste navegador/dispositivo. Os resultados de pesquisa acima continuam disponíveis. Tente Chrome ou Edge atualizado com WebGPU.'}}
function renderCommunity(w){w.innerHTML=`<div class="panel"><h1>Comunidade <span style="font-size:22px">♡</span></h1><p class="panel-intro">Um cantinho para compartilhar ideias com outras pessoas.</p><span class="community-badge">DEMONSTRAÇÃO NESTE APARELHO</span><div class="ai-box" style="margin-top:15px"><b>Importante:</b> por enquanto, as publicações ficam só neste navegador. Para pessoas diferentes interagirem de verdade, o app vai precisar de um servidor gratuito, contas e ferramentas de segurança/moderação.</div><div class="postbox"><textarea id="postText" maxlength="1000" placeholder="Compartilhe uma ideia (até 1.000 caracteres)…"></textarea><button class="primary" id="postBtn">Publicar aqui</button></div><div id="posts"></div></div>`;let draw=()=>{$('#posts').innerHTML=state.posts.length?state.posts.slice().reverse().map(p=>`<div class="post">${esc(p.text).replace(/\n/g,'<br>')}<br><small>Você · ${new Date(p.date).toLocaleString('pt-BR',{dateStyle:'medium',timeStyle:'short'})}</small></div>`).join(''):'<p class="ai-state">Ainda não tem publicações. Você pode testar como funciona — elas ficam só no seu aparelho.</p>'};draw();$('#postBtn').onclick=()=>{let t=$('#postText').value.trim();if(!t)return;state.posts.push({text:t,date:Date.now()});save();$('#postText').value='';draw();toast('Publicação salva neste aparelho.')}}
function renderSettings(w){w.innerHTML=`<div class="panel"><h1>Deixa com a sua cara</h1><p class="panel-intro">Escolha cores e, se quiser, um link de imagem para o fundo do app.</p><div class="settings-grid"><div class="setting"><label for="accent">Cor de destaque</label><input id="accent" type="color" value="${state.settings.accent||'#6557a5'}"></div><div class="setting"><label for="bgcolor">Cor do fundo</label><input id="bgcolor" type="color" value="${state.settings.bg||'#f5f0e8'}"></div><div class="setting"><label for="fontcolor">Cor principal do texto</label><input id="fontcolor" type="color" value="${state.settings.font||'#272522'}"></div><div class="setting"><label for="bgimage">Imagem de fundo (link direto)</label><input id="bgimage" type="url" placeholder="https://…" value="${esc(state.settings.image||'')}"></div></div><p class="ai-state" style="margin-top:20px">Dica: para fotos e GIFs dentro de uma nota, use o botão “Imagem/GIF”. Imagens escolhidas do aparelho ficam nessa nota e podem ocupar espaço de armazenamento.</p><button class="primary" id="resetSettings" style="margin-top:12px">Voltar às cores iniciais</button></div>`;[['accent','accent'],['bgcolor','bg'],['fontcolor','font']].forEach(([id,key])=>$('#'+id).oninput=e=>{state.settings[key]=e.target.value;save();applySettings()});$('#bgimage').onchange=e=>{state.settings.image=e.target.value;save();applySettings()};$('#resetSettings').onclick=()=>{state.settings={accent:'#6557a5',bg:'#f5f0e8',font:'#272522',image:''};save();render()}}
$('#newNote').onclick=newNote;document.querySelectorAll('.navbtn').forEach(b=>b.onclick=()=>{view=b.dataset.view;render();$('#sidebar').classList.remove('open')});$('#menuBtn').onclick=()=>$('#sidebar').classList.toggle('open');$('#bgBtn').onclick=()=>{view='settings';render();$('#bgimage')?.focus()};$('#focusBtn').onclick=()=>document.querySelector('.page')?.requestFullscreen?.();$('#exportBtn').onclick=()=>{let blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='margem-backup.json';a.click();URL.revokeObjectURL(a.href)};$('#importBtn').onclick=()=>$('#importFile').click();$('#importFile').onchange=e=>{let f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{try{let d=JSON.parse(r.result);if(!Array.isArray(d.notes))throw Error();if(confirm('Importar vai substituir as notas atuais. Continuar?')){state={...state,...d};current=state.notes[0]?.id||null;save();render();toast('Backup importado.')}}catch{toast('Esse arquivo não parece ser um backup Margem válido.')}};r.readAsText(f)};window.addEventListener('beforeunload',()=>{let n=state.notes.find(x=>x.id===current),ed=$('#editor');if(n&&ed)n.content=ed.innerHTML;localStorage.setItem(storeKey,JSON.stringify(state))});render();
</script></body></html>
